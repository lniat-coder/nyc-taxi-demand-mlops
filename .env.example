# Copy to .env (never committed) and change ADMIN_TOKEN.
MLFLOW_TRACKING_URI=http://localhost:5000
API_URL=http://localhost:8000
MODEL_NAME=nyc-taxi-demand
# Secret: protects POST /admin/reload. Generate one with: python -c "import secrets; print(secrets.token_hex(16))"
ADMIN_TOKEN=change-me
# Docker image tag of the API (immutable tags, never "latest")
API_IMAGE_TAG=1.0.0
